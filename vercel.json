{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/class.js": { "maxDuration": 60 },
    "api/voice.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/reminders", "schedule": "0 14 * * *" }
  ],
  "headers": [
    { "source": "/photos/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }] },
    { "source": "/icons/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }] }
  ]
}
