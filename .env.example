# Copy to .env.local for local work (npm run dev). In production set the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# --- required: Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The secret / service_role key. Server only — never put it in public/.
SUPABASE_SERVICE_ROLE_KEY=

# --- required: the teacher's secret word (typed on the Students page) ---
TEACHER_KEY=

# --- accounts (sign in / sign up). They switch on by themselves once the accounts migration has been run in Supabase. ---
# AUTH_GOOGLE=1     # show "Continue with Google" (after Google is switched on in Supabase → Authentication → Providers)
# AUTH_OFF=1        # emergency switch: the site goes back to open, no accounts

# --- optional: AI feedback for "Test your speaking" ---
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5          # for much lower cost: claude-haiku-5-5
# AI_MAX_PER_STUDENT_PER_DAY=5
# AI_MAX_PER_DAY=100

# --- optional: pronunciation scoring for the Voice level test (Azure AI Speech, free tier F0 = 5 audio hours a month) ---
# Azure portal → your Speech resource → Keys and Endpoint: KEY 1 and Location/Region (for example uaenorth, westeurope).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=https://NAME.cognitiveservices.azure.com   # only if the region address does not work for your resource
# AZURE_SPEECH_LANGUAGE=en-GB
# VOICE_MAX_PER_STUDENT_PER_DAY=30    # speech-service calls; one full test uses up to 6
# VOICE_MAX_PER_DAY=1500
# PRON_MAX_PER_STUDENT_PER_DAY=60     # Pronounce section: words checked by the speech service; one test is 15 words, up to 3 tries each
# PRON_MAX_PER_DAY=400               # all students together; after a limit the page uses the browser's own check

# --- optional: daily reminder emails (Vercel Cron → /api/reminders, sent with resend.com) ---
CRON_SECRET=
RESEND_API_KEY=
# REMIND_FROM=Do it English <noreply@your-domain.com>
# REMIND_AFTER_DAYS=3
